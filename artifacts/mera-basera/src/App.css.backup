

/* Pro Advanced Filters */
.pro-filters {
  margin: 18px 0 22px;
  padding: 16px;
  border: 1px solid rgba(99, 102, 241, 0.35);
  border-radius: 14px;
  background: rgba(99, 102, 241, 0.06);
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: center;
}

.pro-filter-title {
  width: 100%;
  font-weight: 700;
  margin-bottom: 4px;
}

.pro-filters input[type="number"],
.pro-filters select {
  min-height: 42px;
  padding: 9px 12px;
  border-radius: 9px;
  border: 1px solid #d1d5db;
  background: #fff;
}

.amenities-filter {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  gap: 8px 14px;
  padding-top: 8px;
}

.amenities-title {
  width: 100%;
  font-weight: 600;
}

.amenities-filter label {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 14px;
  cursor: pointer;
}

.amenities-filter input[type="checkbox"] {
  cursor: pointer;
}
